<Window x:Class="FisPresentationPlatform.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="FIS Presentation Studio" Icon="pack://application:,,,/FisPresentationPlatform;component/Assets/fis-presents.ico" Height="920" Width="1440" MinHeight="640" MinWidth="1000"

        WindowStartupLocation="CenterScreen" Background="#101925" Foreground="#F3F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="CyanBrush" Color="#69E43C" />

    </Window.Resources>



    <Grid Background="#101925">

        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border x:Name="SidebarBackground" Grid.Column="0" BorderBrush="#414748" BorderThickness="0,0,1,0" Background="#101925">

            <Grid ClipToBounds="True">

                <Grid.RowDefinitions><RowDefinition x:Name="SidebarLogoRow" Height="Auto" MinHeight="174"/><RowDefinition Height="*"/><RowDefinition x:Name="SidebarFooterRow" Height="64"/></Grid.RowDefinitions>

                <Image x:Name="SidebarArtwork" Grid.RowSpan="3" Source="green-dots-and-swish.png" Width="520" Height="292" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0.5" IsHitTestVisible="False">

                    <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="White" Offset="0.3"/></LinearGradientBrush></Image.OpacityMask>

                </Image>

                <StackPanel x:Name="SidebarHeaderPanel" Margin="14,18,14,14" VerticalAlignment="Top">
                    <Image x:Name="SidebarLogo" Source="Assets/fis-logo.png" Width="84" Height="44" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="FIS" />
                    <Border x:Name="SidebarStatusCard" Margin="0,16,0,0" Padding="10,9,10,8" CornerRadius="8" Background="#B3172331" BorderBrush="#2A3644" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonUp="SidebarStatusCard_Click" AutomationProperties.Name="Session status">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2E4BCD3E" BorderBrush="#4BCD3E" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarUserInitial" Text="?" FontSize="12" FontWeight="SemiBold" Foreground="#69E43C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarUserText" Text="User" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SidebarMachineText" Text="" FontSize="10.5" Foreground="#8A97A6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="#2A3644" Margin="0,8,0,6"/>
                            <Grid x:Name="SidebarStatusRows">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Repo" FontSize="11" Foreground="#8A97A6" Margin="0,2"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2">
                                    <Ellipse x:Name="SidebarRepoDot" Width="7" Height="7" Fill="#8A97A6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="SidebarRepoText" Text="Checking…" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Updates" FontSize="11" Foreground="#8A97A6" Margin="0,2"/>
                                <TextBlock x:Name="SidebarUpdatesText" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Text="Library" FontSize="11" Foreground="#8A97A6" Margin="0,2"/>
                                <TextBlock x:Name="SidebarLibraryText" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SidebarNavPanel" Grid.Row="1">

                    <Button x:Name="WelcomeNavButton" Style="{StaticResource SidebarButtonStyle}" Click="WelcomeNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="22" Width="34"/><TextBlock Text="Welcome" VerticalAlignment="Center"/></StackPanel></Button>

                    <Button x:Name="LibraryNavButton" Style="{StaticResource SidebarButtonStyle}" Click="LibraryNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="22" Width="34"/><TextBlock Text="Demo Library" VerticalAlignment="Center"/></StackPanel></Button>

                    <Button x:Name="DownloadsNavButton" Style="{StaticResource SidebarButtonStyle}" Click="DownloadsNav_Click" ToolTip="Demos published in the repository"><StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="22" Width="34"/><TextBlock Text="Downloads" VerticalAlignment="Center"/></StackPanel></Button>

                    <Button x:Name="RecentNavButton" Style="{StaticResource SidebarButtonStyle}" Click="RecentNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="22" Width="34"/><TextBlock Text="Recent" VerticalAlignment="Center"/></StackPanel></Button>

                    <Button x:Name="SettingsNavButton" Style="{StaticResource SidebarButtonStyle}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="22" Width="34"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>

                    <Border x:Name="SidebarNavSeparator" Height="1" Background="#2E3A47" Margin="22,12,22,12" SnapsToDevicePixels="True" IsHitTestVisible="False"/>

                    <Button x:Name="BuilderNavButton" Style="{StaticResource SidebarButtonStyle}" Click="BuilderNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="22" Width="34"/><TextBlock Text="Build Package" VerticalAlignment="Center"/></StackPanel></Button>

                    <Button Style="{StaticResource SidebarButtonStyle}" Click="OpenPackage_Click" ToolTip="Open a package in the shared Player"><StackPanel Orientation="Horizontal"><TextBlock Text="▷" FontSize="22" Width="34"/><TextBlock Text="Open Demo" VerticalAlignment="Center"/></StackPanel></Button>

                </StackPanel>

                <Button x:Name="AboutButton" Grid.Row="2" Style="{StaticResource HelpCircleButtonStyle}" Click="About_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" ToolTip="About FIS Presents · versions, stats and support" AutomationProperties.Name="About FIS Presents"/>

            </Grid>

        </Border>

    <Grid x:Name="WorkspaceSurface" Grid.Column="1" Background="#101925">

        <Grid.RowDefinitions>

            <RowDefinition x:Name="HeroRow" Height="174" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <Grid x:Name="HeroBanner" Grid.Row="0" ClipToBounds="True" Background="#101925">

            <Border x:Name="HeroArtwork" Width="560" Height="210" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">

                <Border.Background><ImageBrush ImageSource="green-building-banner.png" Stretch="Uniform" AlignmentX="Right" AlignmentY="Center"/></Border.Background>

                <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="White" Offset="0.35"/></LinearGradientBrush></Border.OpacityMask>

            </Border>

            <StackPanel x:Name="HeroTextPanel" Margin="36,18" VerticalAlignment="Center">

                <TextBlock x:Name="HeroTitleText" FontSize="35" FontWeight="Bold"><Run x:Name="HeroVerbRun" Text="Welcome to "/><Run x:Name="HeroSubjectRun" Text="FIS Presents" Foreground="#69E43C"/></TextBlock>

                <TextBlock x:Name="HeroDescriptionText" Text="Stay up to date with news, newly published demos and presentation updates." Foreground="#DCE2DE" FontSize="14" Margin="0,9,0,0"/>

            </StackPanel>

            <Border x:Name="BannerContentDivider" Height="1" Background="{Binding BorderBrush, ElementName=SidebarBackground}" VerticalAlignment="Bottom" IsHitTestVisible="False" />

        </Grid>

        <Grid x:Name="SourceToolbar" Grid.Row="2" Panel.ZIndex="2" VerticalAlignment="Top" Margin="42,66,42,0">

            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <StackPanel x:Name="SourceToolbarIntro" VerticalAlignment="Center">

                <TextBlock Text="Presentation source" FontSize="16" FontWeight="SemiBold" />

                <TextBlock x:Name="SourceToolbarSubtitle" Text="Existing content only · no HTML authoring" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />

            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">

                <TextBox x:Name="SourcePathText" Width="260" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="Selected presentation source folder" />

                <Button Content="Choose folder" Click="BrowseFolder_Click" Margin="8,0,0,0" />

                <Button Content="Load sample" Click="LoadSample_Click" Margin="0" />

            </StackPanel>

        </Grid>



        <StackPanel x:Name="LibraryActions" Grid.Row="2" Panel.ZIndex="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="44" Margin="0,12,24,0" Visibility="Collapsed">

            <Button Style="{StaticResource StripButtonStyle}" Content="Show all demos" Click="ClearLibraryFocus_Click" VerticalAlignment="Center"/>

            <Button Style="{StaticResource StripButtonStyle}" Content="Refresh" Click="RefreshLibrary_Click" VerticalAlignment="Center"/>

            <Button Style="{StaticResource StripButtonStyle}" Content="↓ Downloads" Click="DownloadsNav_Click" VerticalAlignment="Center"/>

            <Button x:Name="ImportDemoButton" Style="{StaticResource StripPrimaryButtonStyle}" Content="+ Import .fisxpkg" Click="ImportDemo_Click" VerticalAlignment="Center"/>

        </StackPanel>

        <Border x:Name="ToastHost" Grid.Row="2" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="18,10" CornerRadius="20"

                Background="#F0182638" BorderBrush="#69E43C" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="760">

            <TextBlock x:Name="ToastText" Foreground="#F5F7F5" FontSize="13" TextWrapping="Wrap"/>

        </Border>

        <TabControl x:Name="MainViews" Grid.Row="2" Margin="22,12,22,0" Padding="7" Background="#101925" BorderBrush="#414748" BorderThickness="1" SelectedIndex="2" SelectionChanged="MainViews_SelectionChanged">

            <TabItem x:Name="BuilderTab" Header="◇  Build Package" Visibility="Collapsed">

                <Grid x:Name="BuilderRoot" Margin="12">

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid x:Name="BuilderIntro" Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="Package the folder as it exists" FontSize="20" FontWeight="SemiBold" />

                            <TextBlock Text="All included HTML, images, video, styles, scripts and other local files are bundled. This workflow does not author or modify HTML." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />

                        </StackPanel>

                        <TextBlock x:Name="PackageSourceSummary" Grid.Column="1" Text="No source folder selected" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="15,0,0,0" />

                    </Grid>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.7*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">

                            <Grid>

                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Grid Margin="0,0,0,12">

                                    <StackPanel>

                                        <TextBlock Text="SOURCE FILE INVENTORY" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11" />

                                        <TextBlock x:Name="AssetSummaryText" Text="Choose a source folder to scan files." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />

                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Rescan" Click="RescanAssets_Click" HorizontalAlignment="Right" />

                                </Grid>

                                <ListBox Grid.Row="1" x:Name="AssetListBox" FontSize="12" />

                            </Grid>

                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">

                            <Border Style="{StaticResource CardStyle}" Padding="20">

                                <StackPanel>

                                    <TextBlock Text="PACKAGE CHECKS" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11" />

                                    <TextBlock Text="Before packaging, the Studio checks the JSON config, entry page, menu paths, common HTML/CSS asset references and package file integrity." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,14" />

                                    <TextBlock Text="Package format" Foreground="{StaticResource MutedBrush}" FontSize="11" />

                                    <TextBlock Text="One portable .fisxpkg file" FontWeight="SemiBold" Margin="0,4,0,13" />

                                    <TextBlock Text="Runtime" Foreground="{StaticResource MutedBrush}" FontSize="11" />

                                    <TextBlock Text="Opened by the shared FIS Presentation Player" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />

                                </StackPanel>

                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">

                                <StackPanel>

                                    <TextBlock Text="CURRENT SCOPE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />

                                    <TextBlock Text="✓ Package existing files" Margin="0,12,0,0" />

                                    <TextBlock Text="✓ Manage the runtime configuration" Margin="0,6,0,0" />

                                    <TextBlock Text="✓ Data sets (edit from a library tile)" Margin="0,6,0,0" />

                                    <TextBlock Text="○ HTML authoring stays in your web tools" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />

                                </StackPanel>

                            </Border>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock x:Name="ValidationText" Text="Select a source folder to begin." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <CheckBox x:Name="AddBuildToLibrary" Content="Add completed package to Demo Library" IsChecked="True" Margin="0,0,12,8"/>

                            <ProgressBar x:Name="BuildProgressBar" Height="4" Maximum="100" Value="0" Visibility="Collapsed" Background="#303637" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">

                            <Button Content="Validate source" Click="Validate_Click" />

                            <Button x:Name="BuildPackageButton" Style="{StaticResource PrimaryButtonStyle}" Content="Build .fisxpkg" Click="BuildPackage_Click" />

                            <Button x:Name="CancelBuildButton" Content="Cancel" Click="CancelBuild_Click" Visibility="Collapsed" />

                            <Button Content="Open package" Click="OpenPackage_Click" Margin="0" />

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>



            <TabItem x:Name="ConfigurationTab" Header="⚙  Configuration Studio" Visibility="Collapsed">

                <Grid x:Name="ConfigRoot" Margin="12">

                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <TabControl x:Name="ConfigEditorTabs" Padding="12">

                        <TabItem Header="⚙  General">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid>

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Border x:Name="ConfigOrgCard" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="22" Margin="0,16,0,0">

                                <StackPanel>

                                    <TextBlock Text="Organization" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,6" />

                                    <TextBlock Text="Tags the demo for business filtering. L8 is the solution and is matched against user assignments." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="6">

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="L3 · Business" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="OrgL3Combo" Margin="0,4,0,0" SelectionChanged="OrgL3Combo_SelectionChanged"/></StackPanel>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="L4" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrgL4Text" Margin="0,4,0,0"/></StackPanel>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="L5" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrgL5Text" Margin="0,4,0,0"/></StackPanel>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="L6" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrgL6Text" Margin="0,4,0,0"/></StackPanel>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="L7" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrgL7Text" Margin="0,4,0,0"/></StackPanel>

                                        <StackPanel><TextBlock Text="L8 · Solution" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="OrgL8Text" Margin="0,4,0,0"/></StackPanel>

                                    </UniformGrid>

                                </StackPanel>

                            </Border>

                            <Border x:Name="ConfigDetailsCard" Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,8,0">

                                <StackPanel>

                                    <TextBlock Text="Presentation Details" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,9">

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="ID" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="ConfigIdText" Margin="0,4,0,0" /></StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="NameText" Margin="0,4,0,0" /></StackPanel>

                                        <StackPanel Grid.Column="2"><TextBlock Text="Version" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="VersionText" Margin="0,4,0,0" /></StackPanel>

                                    </Grid>

                                    <TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="DescriptionText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="220" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />

                                </StackPanel>

                            </Border>

                            <Border x:Name="ConfigBrandingCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="8,0,0,0">

                                <StackPanel>

                                    <TextBlock Text="Runtime &amp; Branding" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,9">

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Entry point (existing file)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="EntryPointText" Margin="0,4,0,0" /></StackPanel>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock Text="Accent color" Foreground="{StaticResource MutedBrush}" FontSize="11"/>

                                            <Grid Margin="0,4,0,0">

                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                                <TextBox x:Name="AccentText" />

                                                <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4" Margin="6,0,0,0" BorderBrush="#454B4D" BorderThickness="1" Background="{Binding Text, ElementName=AccentText, FallbackValue=Transparent, TargetNullValue=Transparent}" />

                                            </Grid>

                                        </StackPanel>

                                    </Grid>

                                    <TextBlock Text="Local logo path (optional)" Foreground="{StaticResource MutedBrush}" FontSize="11"/>

                                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BrandLogoPathText"/><Button Grid.Column="1" Content="Browse" Click="BrowseLogo_Click" Margin="6,0,0,0" Padding="10,4" /></Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="Library tile theme" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <ComboBox x:Name="TileThemeCombo" Margin="0,4,0,0" SelectionChanged="TileThemeCombo_SelectionChanged" AutomationProperties.Name="Library tile theme">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="#5A6265" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="Colours the Demo Library and Downloads tile banner. Green uses the accent colour for the swoosh." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="160" Height="73" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top" ToolTip="Tile banner preview">
                                            <Grid>
                                                <Image x:Name="TileThemePreview" Stretch="UniformToFill"/>
                                                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,6">
                                                    <TextBlock x:Name="TileThemePreviewBusiness" FontSize="7" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="TileThemePreviewTitle" Foreground="White" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">

                                        <Button DockPanel.Dock="Left" Content="Apply presentation settings" Click="ApplyMetadata_Click" VerticalAlignment="Center" />

                                        <TextBlock Text="Pages and navigation are configured here; edit HTML in your web authoring tools." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />

                                    </DockPanel>

                                </StackPanel>

                            </Border>

                            </Grid>

                        </ScrollViewer>

                        </TabItem>

                        <TabItem Header="▦  Menu &amp; Pages">

                        <Grid>

                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>

                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <Border x:Name="MenuSectionsCard" Style="{StaticResource CardStyle}" Padding="18">

                                <Grid>

                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="MENU SECTIONS" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Order here becomes runtime order." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>

                                        <CheckBox Grid.Column="1" x:Name="NavigationEnabledCheckBox" Content="Menu on" IsChecked="True" Foreground="White" VerticalAlignment="Center" Checked="NavigationEnabled_Changed" Unchecked="NavigationEnabled_Changed"/>

                                    </Grid>

                                    <ListBox Grid.Row="1" x:Name="SectionsListBox" DisplayMemberPath="Title" SelectionChanged="SectionsListBox_SelectionChanged" Margin="0,10,0,10" MinHeight="80"/>

                                    <StackPanel Grid.Row="2">

                                        <Grid Margin="0,0,0,8">

                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                            <TextBox x:Name="SectionTitleText" ToolTip="Selected menu section title" VerticalContentAlignment="Center" />

                                            <Button Grid.Column="1" Content="Apply" Click="ApplySection_Click" Margin="6,0,0,0" Padding="10,7" />

                                        </Grid>

                                        <WrapPanel HorizontalAlignment="Right">

                                            <Button Content="+ Section" Click="AddSection_Click" Padding="10,7" Margin="0,0,4,0"/>

                                            <Button Content="&#8593;" ToolTip="Move section up" Click="MoveSectionUp_Click" Padding="10,7" Margin="0,0,4,0"/>

                                            <Button Content="&#8595;" ToolTip="Move section down" Click="MoveSectionDown_Click" Padding="10,7" Margin="0,0,4,0"/>

                                            <Button Content="Remove" Click="RemoveSection_Click" Padding="10,7" Margin="0"/>

                                        </WrapPanel>

                                    </StackPanel>

                                </Grid>

                            </Border>

                            <Border x:Name="MenuPagesCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">

                                <Grid>

                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="PAGES IN THIS SECTION" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Pages must already exist in the source folder." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>

                                        <Button Grid.Column="1" Content="+ Existing HTML page" Click="AddPage_Click" Padding="10,7" Margin="0"/>

