                        </Grid>

                        </TabItem>

                        <TabItem x:Name="DataSetsEditorTab" Header="◫  Data Sets">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DATA SETS" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock x:Name="DataSetsSummaryText" Text="Personas and figures offered on the demo start dialog." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ListBox Grid.Row="1" x:Name="DataSetsListBox" Margin="0,10,0,10" MinHeight="80" SelectionChanged="DataSetsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Meta}" FontSize="10.5" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{Binding BadgeBrush}">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#0B1622" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Grid.Row="2">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ New data set…" Click="NewDataSet_Click" Padding="10,7" Margin="0,0,4,4" ToolTip="Create a data set from an existing one (override or full copy) or from blank"/>
                                        <Button Content="Import JSON…" Click="ImportDataSet_Click" Padding="10,7" Margin="0,0,4,4"/>
                                        <Button Content="Remove" Click="RemoveDataSet_Click" Padding="10,7" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                                <Grid x:Name="DataSetDetailGrid" IsEnabled="False">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="DataSetNameText" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="ID" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="DataSetIdText" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Persona" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="DataSetPersonaText" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Description" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="DataSetDescriptionText" Margin="0,4,0,0"/></StackPanel>
                                        <CheckBox Grid.Column="4" x:Name="DataSetDefaultCheckBox" Content="Default" Foreground="White" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </Grid>
                                    <Border Grid.Row="1" x:Name="DataSetHealthBorder" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Background="#1A2A3A" BorderBrush="#2A3A4C" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="DataSetHealthText" TextWrapping="Wrap" FontSize="11.5"/>
                                            <TextBlock x:Name="DataSetStructureText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DataSetFileText" Text="DATA FILE" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Button Content="Format" Click="FormatDataSet_Click" Padding="9,5" Margin="0,0,4,0"/>
                                            <Button Content="Check" Click="CheckDataSet_Click" Padding="9,5" Margin="0,0,4,0" ToolTip="Validate the JSON and compare its structure with the default data set"/>
                                            <Button Content="Revert" Click="RevertDataSet_Click" Padding="9,5" Margin="0,0,4,0"/>
                                            <Button Content="Open folder" Click="OpenDataFolder_Click" Padding="9,5" Margin="0,0,4,0"/>
                                            <Button Content="▶ Preview" Click="PreviewDataSet_Click" Padding="9,5" Margin="0,0,4,0" ToolTip="Save, build a temporary package and open the Player with this data set"/>
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save data set" Click="SaveDataSet_Click" Padding="12,5" Margin="0"/>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBox Grid.Row="3" x:Name="DataSetJsonText" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas" FontSize="12" Padding="10"/>
                                </Grid>
                            </Border>
                        </Grid>
                        </TabItem>
                        <TabItem Header="{}{ }  JSON">

                        <Border Style="{StaticResource CardStyle}" Padding="18">

                            <Grid>

                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                <Grid Margin="0,0,0,10">

                                    <StackPanel><TextBlock Text="PRESENTATION.JSON" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Visual changes update this document. Raw edits apply on reload." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>

                                    <Button Grid.Column="1" Content="Apply JSON" Click="ApplyJson_Click" HorizontalAlignment="Right" />

                                </Grid>

                                <TextBox Grid.Row="1" x:Name="ConfigTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas" FontSize="12" Padding="13" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">

                                    <Button Content="Reload from folder" Click="ReloadConfig_Click" />

                                    <Button Content="Validate config" Click="ValidateEditorConfig_Click" />

                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save presentation.json" Click="SaveConfig_Click" Margin="0" />

                                </StackPanel>

                            </Grid>

                        </Border>

                        </TabItem>

                    </TabControl>

                    <Border x:Name="ConfigFooter" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="15,10">

                        <Grid>

                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                            <TextBlock x:Name="EditorStatusText" Text="Select a source folder to load its config and organize existing pages." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">

                                <Button Content="Validate" Click="ValidateEditorConfig_Click"/>

                                <Button x:Name="SaveAsNewDemoButton" Content="Save as new demo…" Click="SaveAsNewDemo_Click" ToolTip="Create a new .fisxpkg demo from these settings and add it to your Demo Library"/>

                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save Configuration" Click="SaveConfig_Click" Margin="0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </Grid>

            </TabItem>

            <TabItem x:Name="WelcomeTab" Header="Welcome">

                <Grid Margin="18,18,18,0">

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Latest news, published demos &amp; updates" FontSize="22" FontWeight="SemiBold"/>

                            <TextBlock x:Name="WelcomeStatusText" Text="Configure an approved feed to receive published content." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,7,16,0"/>

                        </StackPanel>

                        <Button x:Name="RefreshWelcomeButton" Grid.Column="1" Content="Refresh news" Click="RefreshWelcome_Click" VerticalAlignment="Top" Margin="0"/>

                    </Grid>

                    <Grid Grid.Row="1">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <ItemsControl x:Name="WelcomeItems">

                                <ItemsControl.ItemTemplate><DataTemplate>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="24">

                                        <Grid>

                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,18,0">

                                                <TextBlock Text="{Binding TypeLabel}" Foreground="#69E43C" FontSize="11" FontWeight="Bold"/>

                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,6"/>

                                                <TextBlock Text="{Binding Summary}" Foreground="#DEE3E0" TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding Metadata}" Foreground="#95D27C" FontSize="12" Margin="0,10,0,0"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">

                                                    <Button Content="Read post →" Click="ReadWelcomePost_Click" Tag="{Binding}" Foreground="#69E43C" BorderBrush="#69E43C"/>

                                                    <Button Content="View demo in Library" Click="WelcomeDemoLink_Click" Tag="{Binding}">

                                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDemoLink}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>

                                                    </Button>

                                                </StackPanel>

                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="#BEC4C2" FontSize="12"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate></ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                        <StackPanel x:Name="WelcomeEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">

                            <TextBlock Text="Welcome to FIS Presents" FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>

                            <TextBlock Text="Your Demo Library is available offline. Configure the published-content repository in Settings to receive news and updates." Foreground="#BEC4C2" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

            <TabItem x:Name="LibraryTab" Header="Demo Library">

                <Grid Margin="14,14,14,0">

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <Grid>

                            <TextBox x:Name="LibrarySearchText" ToolTip="Search titles, solutions, organization, functions and tags" TextChanged="LibraryFilters_Changed" VerticalContentAlignment="Center"/>

                            <TextBlock Text="⌕  Search demos, solutions and organization…" IsHitTestVisible="False" Foreground="#AAB4AF" Margin="13,0" VerticalAlignment="Center">

                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibrarySearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>

                            </TextBlock>

                        </Grid>

                        <ComboBox x:Name="LibraryBusinessFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="LibraryFilters_Changed" ToolTip="Filter by business (L3)"/>

                        <ComboBox x:Name="LibrarySort" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="LibraryFilters_Changed" SelectedIndex="0">

                            <ComboBoxItem Content="Name"/><ComboBoxItem Content="Newest imported"/><ComboBoxItem Content="Recently launched"/>

                        </ComboBox>

                        <CheckBox x:Name="LibraryFavoritesOnly" Grid.Column="3" Content="Favorites" Margin="14,0,0,0" VerticalAlignment="Center" Checked="LibraryFilters_Changed" Unchecked="LibraryFilters_Changed"/>

                        <CheckBox x:Name="LibraryMySolutions" Grid.Column="4" Content="My solutions" Margin="14,0,0,0" VerticalAlignment="Center" Checked="LibraryFilters_Changed" Unchecked="LibraryFilters_Changed" ToolTip="Only demos for the L8 solutions assigned to you"/>

                    </Grid>

                    <TextBlock x:Name="LibraryCountText" Grid.Row="1" Text="Available Demonstrations (0)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Grid Grid.Row="2">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="LibraryCards">

                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Width="320" Padding="0" Margin="0,0,16,18" ClipToBounds="True">

                                            <Border.Style>

                                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">

                                                    <Style.Triggers><DataTrigger Binding="{Binding Highlighted}" Value="True"><Setter Property="BorderBrush" Value="#69E43C"/><Setter Property="BorderThickness" Value="3"/></DataTrigger></Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <Grid>

                                                <Grid.RowDefinitions><RowDefinition Height="146"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                                <Border CornerRadius="11,11,0,0" ClipToBounds="True">
                                                    <Grid ClipToBounds="True">
                                                        <Image Source="{Binding Banner}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,12" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding Business}" Foreground="{Binding LineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                                                            <Button Style="{StaticResource FavoriteStarButtonStyle}" Click="FavoriteDemo_Click" Tag="{Binding Record}" Margin="0,0,6,0" ToolTip="{Binding FavoriteTip}" AutomationProperties.Name="{Binding FavoriteTip}"/>
                                                            <Button Style="{StaticResource TileMenuButtonStyle}" Click="DemoMenu_Click" Tag="{Binding Record}" VerticalAlignment="Center" ToolTip="Edit configuration or uninstall" AutomationProperties.Name="Demo options"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="16">
                                                    <TextBlock Text="{Binding Description}" ToolTip="{Binding Classification}" Foreground="#DEE3E0" TextWrapping="Wrap" Height="60" TextTrimming="CharacterEllipsis"/>
                                                    <Border BorderBrush="#414748" BorderThickness="0,1,0,0" Margin="0,10,0,10" Padding="0,9,0,0">
                                                        <TextBlock Text="{Binding FooterLabel}" FontSize="11" Foreground="#BEC4C2"/>
                                                    </Border>
                                                    <Grid>

                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                                        <Button Content="View Details" Tag="{Binding Record}" Click="DemoDetails_Click" HorizontalAlignment="Left" Foreground="#69E43C" BorderBrush="#69E43C" Padding="12,8"/>

                                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Launch Demo →" Tag="{Binding Record}" Click="LaunchDemo_Click" IsEnabled="{Binding Available}" Margin="0" Padding="13,8"/>

                                                    </Grid>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                        <StackPanel x:Name="LibraryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">

                            <TextBlock Text="Your demos, in one place." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                            <TextBlock x:Name="LibraryEmptyText" Text="Import a verified .fisxpkg to start your local library, or build a package from existing content." Foreground="#BEC4C2" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,18"/>

                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Import a demo package" Click="ImportDemo_Click" HorizontalAlignment="Center"/>

                            <Button Content="Browse Downloads" Click="DownloadsNav_Click" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Settings" Visibility="Collapsed">

                <Grid>

                    <TabControl x:Name="SettingsTabs" Padding="20,20,20,0">

                        <TabItem Header="Storage &amp; Backups">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel MaxWidth="850" HorizontalAlignment="Left">

                                    <TextBlock Text="Local library" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <TextBox x:Name="SettingsLibraryPath" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal"><Button Content="Choose folder" Tag="library" Click="BrowseSettingsFolder_Click"/><Button Content="Open folder" Tag="library" Click="OpenSettingsFolder_Click"/></StackPanel>

                                    <TextBlock Text="Changing this location selects another library. Existing demos are not moved or deleted." TextWrapping="Wrap" Foreground="#BEC4C2" Margin="0,10,0,20"/>

                                    <TextBlock Text="Playback cache" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <TextBox x:Name="SettingsCachePath" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal"><Button Content="Choose folder" Tag="cache" Click="BrowseSettingsFolder_Click"/><Button Content="Open folder" Tag="cache" Click="OpenSettingsFolder_Click"/></StackPanel>

                                    <TextBlock Text="Applies to new Player sessions. Existing sessions retain their cache until closed." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,10,0,20"/>

                                    <TextBlock Text="Library backups" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                    <TextBox x:Name="SettingsBackupPath" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal"><Button Content="Choose folder" Tag="backup" Click="BrowseSettingsFolder_Click"/><Button Content="Open folder" Tag="backup" Click="OpenSettingsFolder_Click"/><Button Content="Back up now" Click="BackupNow_Click"/></StackPanel>

                                    <CheckBox x:Name="SettingsAutoBackup" Content="Back up the library before imports and favorite changes" Margin="0,15,0,10"/>

                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Backups to keep (1–50)" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SettingsBackupCount" Width="80"/></StackPanel>

                                    <TextBlock Text="ZIP snapshots include packages, covers and the library index. Restore into a separate folder, then select that folder as the library location." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,12,0,0"/>

                                </StackPanel>

                            </ScrollViewer>

                        </TabItem>

                        <TabItem Header="Remote Repository">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel MaxWidth="850" HorizontalAlignment="Left">

                                <TextBlock Text="Demo repository" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="Shared folder holding repository.json, assignments.json and published .fisxpkg versions. Checked on launch for updates; Downloads lists everything published here." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBox x:Name="SettingsRepositoryPath" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Button Content="Choose folder" Tag="repository" Click="BrowseSettingsFolder_Click"/><Button Content="Open folder" Tag="repository" Click="OpenSettingsFolder_Click"/></StackPanel>

                                <TextBlock Text="News feed" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <TextBlock Text="Approved HTTPS JSON feed for news, newly published demos and version announcements." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBox x:Name="WelcomeFeedUrlText" Margin="0,0,0,16"/>

                                <CheckBox x:Name="SettingsCheckOnLaunch" Content="Automatically check for published demos and updates on launch" Margin="0,0,0,14"/>

                                <CheckBox x:Name="SettingsPeriodicChecks" Content="Check periodically while Studio is open" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal"><TextBlock Text="Check every (minutes, 5–10080)" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SettingsCheckMinutes" Width="90"/></StackPanel>

                                <Button Content="Check now" Click="CheckRepositoryNow_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/>

                                <TextBlock Text="The last valid news feed, repository index and assignments are cached locally, so Studio keeps working offline. Downloaded packages are verified against the repository SHA-256 before they are installed." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,20,0,0"/>

                            </StackPanel>

                            </ScrollViewer>

                        </TabItem>

                        <TabItem Header="Startup &amp; Display">

                            <StackPanel MaxWidth="850" HorizontalAlignment="Left">

                                <TextBlock Text="Display size" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">

                                    <ComboBox x:Name="SettingsDisplayScale" Width="220" SelectionChanged="SettingsDisplayScale_SelectionChanged"/>

                                    <TextBlock x:Name="SettingsDisplayScaleText" Foreground="#BEC4C2" VerticalAlignment="Center" Margin="14,0,0,0"/>

                                </StackPanel>

                                <TextBlock Text="Auto fits the Studio to your screen: smaller on laptops, slightly larger on big monitors, with a compact header on short screens. Applies immediately. Shortcuts: Ctrl + / Ctrl − / Ctrl 0 (back to Auto)." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,12,0,30"/>

                                <TextBlock Text="Windows startup" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>

                                <CheckBox x:Name="SettingsStartWindows" Content="Start FIS Presents when I sign in to Windows"/>

                                <TextBlock Text="Applies only to your Windows account and does not require administrator permissions. Uses the current app location; save again after moving or reinstalling the app." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,15,0,0"/>

                                <TextBlock Text="Studio opens on Welcome with Demo Library beside it. No presentation is launched automatically." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,15,0,0"/>

                            </StackPanel>

                        </TabItem>

                        <TabItem x:Name="UsageSettingsTab" Header="Usage Tracking">

                            <Grid>

                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Grid Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                                        <CheckBox x:Name="SettingsTrackDefault" Content="Track demo sessions by default (can be changed on each demo start)"/>

                                        <CheckBox x:Name="SettingsUploadUsage" Content="Upload usage to the demo repository in the background on start" Margin="0,10,0,0"/>

                                        <TextBlock Text="Tracked sessions record the demo, its L3–L8 tags, persona, reason, client name, opportunity ID, pages viewed and duration. Events are stored locally first and uploaded only after the repository connection check passes." Foreground="#BEC4C2" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">

                                        <Button Style="{StaticResource StripButtonStyle}" Content="Open folder" Click="OpenUsageFolder_Click"/>

                                        <Button x:Name="UploadUsageButton" Style="{StaticResource StripPrimaryButtonStyle}" Content="Upload now" Click="UploadUsageNow_Click"/>

                                    </StackPanel>

                                </Grid>

                                <TextBlock x:Name="UsageSummaryText" Grid.Row="1" Text="No usage recorded yet." FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <ListView x:Name="UsageSessionsList" Grid.Row="2" Style="{StaticResource DataListViewStyle}">

                                    <ListView.View><GridView>

                                        <GridViewColumn Header="Started" Width="130" DisplayMemberBinding="{Binding StartedLabel}"/>

                                        <GridViewColumn Header="Demo" Width="190" DisplayMemberBinding="{Binding DemoName}"/>

                                        <GridViewColumn Header="Client · OID" Width="200" DisplayMemberBinding="{Binding DealLabel}"/>

                                        <GridViewColumn Header="Persona" Width="150" DisplayMemberBinding="{Binding Persona}"/>

                                        <GridViewColumn Header="Reason" Width="130" DisplayMemberBinding="{Binding Reason}"/>

                                        <GridViewColumn Header="Pages" Width="60" DisplayMemberBinding="{Binding Pages}"/>

                                        <GridViewColumn Header="Duration" Width="80" DisplayMemberBinding="{Binding DurationLabel}"/>

                                        <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding StateLabel}"/>

                                    </GridView></ListView.View>

                                </ListView>

                            </Grid>

                        </TabItem>

                        <TabItem x:Name="LogsSettingsTab" Header="Logs">

                            <Grid>

                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Grid Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                    <ComboBox x:Name="LogFileSelector" SelectionChanged="LogFilters_Changed" ToolTip="Log day"/>

                                    <ComboBox x:Name="LogLevelFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="LogFilters_Changed" SelectedIndex="0" ToolTip="Minimum level">

                                        <ComboBoxItem Content="All levels"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="Errors"/>

                                    </ComboBox>

                                    <Grid Grid.Column="2" Margin="8,0,0,0">

                                        <TextBox x:Name="LogSearchText" TextChanged="LogFilters_Changed" VerticalContentAlignment="Center"/>

                                        <TextBlock Text="⌕  Filter log messages…" IsHitTestVisible="False" Foreground="#AAB4AF" Margin="13,0" VerticalAlignment="Center">

                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LogSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>

                                        </TextBlock>

                                    </Grid>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">

                                        <Button Style="{StaticResource StripButtonStyle}" Content="Refresh" Click="RefreshLogs_Click"/>

                                        <Button Style="{StaticResource StripButtonStyle}" Content="Open folder" Click="OpenLogFolder_Click" Margin="0"/>

                                    </StackPanel>

                                </Grid>

                                <ListView x:Name="LogEntriesList" Grid.Row="1" Style="{StaticResource DataListViewStyle}">

                                    <ListView.View><GridView>

                                        <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding TimeLabel}"/>

                                        <GridViewColumn Header="Level" Width="65">

                                            <GridViewColumn.CellTemplate><DataTemplate>

                                                <TextBlock Text="{Binding Level}" FontWeight="Bold">

                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#95D27C"/><Style.Triggers>

                                                        <DataTrigger Binding="{Binding Level}" Value="WARN"><Setter Property="Foreground" Value="#F2C15B"/></DataTrigger>

                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="#FF8B7D"/></DataTrigger>

                                                    </Style.Triggers></Style></TextBlock.Style>

                                                </TextBlock>

                                            </DataTemplate></GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                        <GridViewColumn Header="Area" Width="110" DisplayMemberBinding="{Binding Category}"/>

                                        <GridViewColumn Header="Message" Width="760">

                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>

                                        </GridViewColumn>

                                    </GridView></ListView.View>

                                </ListView>

                            </Grid>

                        </TabItem>

                    </TabControl>

                    <StackPanel x:Name="SettingsActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="44" Margin="0,0,4,0">

                        <TextBlock x:Name="SettingsStatusText" Text="Settings apply after saving." Foreground="#BEC4C2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <Button x:Name="SaveSettingsButton" Style="{StaticResource StripPrimaryButtonStyle}" Content="Save Settings" Click="SaveSettings_Click" VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <TabItem x:Name="DownloadsTab" Header="Downloads" Visibility="Collapsed">

                <Grid Margin="14,14,14,0">

                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <Grid>

                            <TextBox x:Name="DownloadsSearchText" TextChanged="DownloadsFilters_Changed" VerticalContentAlignment="Center"/>

                            <TextBlock Text="⌕  Search published demos and organization…" IsHitTestVisible="False" Foreground="#AAB4AF" Margin="13,0" VerticalAlignment="Center">

                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DownloadsSearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>

                            </TextBlock>

                        </Grid>

                        <ComboBox x:Name="DownloadsBusinessFilter" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="DownloadsFilters_Changed" ToolTip="Filter by business (L3)"/>

                        <CheckBox x:Name="DownloadsMySolutions" Grid.Column="2" Content="My solutions" Margin="14,0,0,0" VerticalAlignment="Center" Checked="DownloadsFilters_Changed" Unchecked="DownloadsFilters_Changed" ToolTip="Only demos for the L8 solutions assigned to you"/>

                        <CheckBox x:Name="DownloadsUpdatesOnly" Grid.Column="3" Content="Not installed / updates" Margin="14,0,0,0" VerticalAlignment="Center" Checked="DownloadsFilters_Changed" Unchecked="DownloadsFilters_Changed"/>

                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">

                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                        <TextBlock x:Name="DownloadsCountText" Text="Published Demonstrations (0)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBlock x:Name="DownloadsStatusText" Grid.Column="1" Text="Demo repository" Foreground="#BEC4C2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">

                            <Button x:Name="DownloadAllUpdatesButton" Content="Update all" Click="DownloadAllUpdates_Click"/>

                            <Button Content="Refresh" Click="RefreshDownloads_Click" Margin="0"/>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="2">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="DownloadCards">

                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Style="{StaticResource CardStyle}" Width="320" Padding="0" Margin="0,0,16,18" ClipToBounds="True">

                                            <Grid>

                                                <Grid.RowDefinitions><RowDefinition Height="146"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border CornerRadius="11,11,0,0" ClipToBounds="True">
                                                    <Grid ClipToBounds="True">
                                                        <Image Source="{Binding Banner}" Stretch="UniformToFill" IsHitTestVisible="False"/>
                                                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,12" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding Business}" Foreground="{Binding LineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Background="#E60B1622" BorderBrush="{Binding StateBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                                                            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="16">
                                                    <TextBlock Text="{Binding Description}" ToolTip="{Binding Classification}" Foreground="#DEE3E0" TextWrapping="Wrap" Height="60" TextTrimming="CharacterEllipsis"/>
                                                    <Border BorderBrush="#414748" BorderThickness="0,1,0,0" Margin="0,10,0,10" Padding="0,9,0,0" ToolTip="{Binding ReleaseNotes}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding LatestLabel}" FontSize="11" Foreground="#BEC4C2"/>
                                                            <TextBlock Text="{Binding InstalledLabel}" FontSize="11" Foreground="#8E9DAC" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ActionLabel}" IsEnabled="{Binding CanDownload}" Tag="{Binding}" Click="DownloadDemo_Click" HorizontalAlignment="Right" Margin="0"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                        <StackPanel x:Name="DownloadsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="Collapsed">

                            <TextBlock Text="Nothing to show here." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                            <TextBlock x:Name="DownloadsEmptyText" Text="" Foreground="#BEC4C2" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

    <Border x:Name="StartupOverlay" Grid.ColumnSpan="2" Panel.ZIndex="50" Background="#F5101925" Visibility="Collapsed" Padding="36">

        <Grid Width="840" MaxWidth="840" HorizontalAlignment="Center">

            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,22">

                <Image Source="Assets/fis-logo.png" Width="90" Height="45" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,18"/>

                <TextBlock Text="Preparing your workspace" FontSize="32" FontWeight="SemiBold"/>

                <TextBlock Text="Local readiness, demo repository and updates" Foreground="#BEC4C2" FontSize="15" Margin="0,8,0,0"/>

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="StartupCheckList">

                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="420"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate><DataTemplate>

                        <Border Style="{StaticResource CardStyle}" Height="50" Padding="16,0" Margin="0,0,12,8" ToolTip="{Binding Message}">

                            <Grid>

                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Symbol}" FontSize="20" VerticalAlignment="Center">

                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#8E9DAC"/><Style.Triggers>

                                        <DataTrigger Binding="{Binding Status}" Value="Passed"><Setter Property="Foreground" Value="#69E43C"/></DataTrigger>

                                        <DataTrigger Binding="{Binding Status}" Value="Checking"><Setter Property="Foreground" Value="#69E43C"/></DataTrigger>

                                        <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="#F2C15B"/></DataTrigger>

                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#FF8B7D"/></DataTrigger>

                                    </Style.Triggers></Style></TextBlock.Style>

                                </TextBlock>

                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#BEC4C2" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>

                            </Grid>

                        </Border>

                    </DataTemplate></ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <TextBlock x:Name="StartupSummaryText" Text="Running startup checks…" Foreground="#BEC4C2" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <Button x:Name="StartupContinueButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Checking…" IsEnabled="False" Click="StartupContinue_Click" Margin="0"/>

            </Grid>

        </Grid>

    </Border>

    </Grid>

</Window>

