                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                        <TextBlock Text="Menu label" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,6"/>

                                        <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="PageTitleText" ToolTip="Runtime menu label" Margin="0,0,0,6"/>

                                        <TextBlock Grid.Row="1" Text="Page path" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,8"/>

                                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PagePathText" ToolTip="Relative path to an existing HTML page or media entry" Margin="0,0,0,8"/>

                                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Right">

                                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Apply page" Click="ApplyPage_Click" Padding="12,7" Margin="0,0,4,0"/>

                                            <Button Content="&#8593;" ToolTip="Move page up" Click="MovePageUp_Click" Padding="10,7" Margin="0,0,4,0"/>

                                            <Button Content="&#8595;" ToolTip="Move page down" Click="MovePageDown_Click" Padding="10,7" Margin="0,0,4,0"/>

                                            <Button Content="Remove" Click="RemovePage_Click" Padding="10,7" Margin="0"/>

