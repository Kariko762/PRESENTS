<UserControl x:Class="FisPresentationPlatform.Controls.DemoLoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101925" Foreground="White" IsVisibleChanged="LoadingVisibilityChanged">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="550" Margin="28">
            <Image Source="/FisPresentationPlatform;component/Assets/fis-logo.png" Width="110" Height="56" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,26"/>
            <Grid Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Ellipse Stroke="#23384B" StrokeThickness="5"/>
                <Path x:Name="Spinner" Data="M 38,3 A 35,35 0 0 1 73,38" Stroke="#69E43C" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock Text="Preparing your demo" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="LoadingMessage" Text="Validating the package and preparing the presentation…" FontSize="14" Foreground="#BECBD6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>